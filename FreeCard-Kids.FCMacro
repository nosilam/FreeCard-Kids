)
#from create_vcard_qr_svg import create_qr
from vcard_qr_matrix import QR_MATRIX, QR_MODULES

def get_qr_module_size():

    return QR_SIZE / QR_MODULES
    
print("FreeCard Config geladen")
print("-----------------------")
print("Karte:", CARD_WIDTH, "x", CARD_HEIGHT)
print("QR:", QR_SIZE)
